# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag_db

# Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Configuration (OpenAI-compatible Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama31-rag

# Retrieval & Reranker Configuration
RETRIEVER=hybrid-bm25
USE_RERANKER=false
MIN_SCORE=0.60
# RERANK_MIN_SCORE=0.502152

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8001

